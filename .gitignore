# --- private / machine-local (never committed) ------------------------------
# no trailing slash: a .venv linked in (a worktree junction, a symlink) is not a folder to git
.venv
data/
config/*.json
!config/*.sample.json
# the installer's timestamped copies of a config before it adds keys to it
config/backups/
.env
mirror/
/webapp/
.launcher-tmp/
# scratch an agent or a tool leaves at the root
/tmp/
*.log

# --- python / tooling ------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- e2e scratch (screenshots the suite keeps live in docs/screenshots) ------
tests/e2e/_shots/
test-results/

# --- agent noise (real config lives machine-scope; AGENTS.md IS committed) --
.agents/
.codex/
# .claude/ stays private except the reviewed project skill (project-scaffolding docs/agents/project-skills.md)
**/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/verify-task-os/
.proof/

# The app password hash (src/password.py)
config/app_password.json

# Top-up backups of a settings file hold its values (src/installer.py)
*.json.bak-*
