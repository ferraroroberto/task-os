%% task-os — internal architecture (hand-authored; update in the same PR as
%% any material structural change: a new route family, a new src module, a
%% new client surface, a schema step). Not generated, not checked by the gate.
flowchart LR
  subgraph clients["Clients"]
    pwa["PWA · app/webapp/static/<br/>app.js (state · URL ↔ filters · #task/id)<br/>board.js · table.js · tree.js · today.js<br/>drawer.js · quickadd.js · format.js · api.js · toast.js<br/>login.html (token / password → cookie)"]
    phone["Phone · https://‹host›.ts.net:8448<br/>installed PWA (manifest · icons · iOS meta)"]
    cli["tasks CLI<br/>src/cli.py · tasks.bat"]
    llm["LLM / scripts<br/>(HTTP or CLI --json)"]
    notion["scripts/import_notion.py<br/>Notion REST → one-shot import"]
  end

  subgraph webapp["FastAPI webapp · :8448 (HTTPS when webapp/certificates/ exists)<br/>app/webapp/server.py"]
    authmw["src/auth.py · AuthMiddleware<br/>loopback = owner · else bearer / cookie<br/>public: /static /healthz /api/version /login"]
    misc["routers/misc<br/>/ · /healthz · /api/version"]
    authr["routers/auth<br/>/login · /api/login · /api/logout · /api/status"]
    tasksr["routers/tasks<br/>/api/tasks… · /api/activity<br/>/api/parse (quick-add)"]
    peopler["routers/people<br/>/api/people…"]
    searchr["routers/search<br/>/api/search"]
    viewsr["routers/views<br/>/api/board · /api/today"]
    errors["JSON error envelope<br/>{error:{code,message,detail?}}"]
  end

  subgraph domain["Domain · src/"]
    repo["tasks_repo.py<br/>create/update/move/done<br/>comments · links · people<br/>issue_refs · search · activity<br/>board · today_view (buckets)"]
    dates["dates.py<br/>parse_date · advance"]
    qa["quick_add.py<br/>parse · resolve_parent"]
    schema["schema.py<br/>MIGRATIONS v1→v3 · migrate()"]
    db["db.py<br/>connect · init_db · get_db"]
    config["config.py<br/>config/config.json · auth {token, password_hash}<br/>save_auth() ← scripts/gen_token.py · set_password.py"]
    certs["certs.py<br/>webapp/certificates/{cert,key}.pem<br/>ensure_cert_fresh() → scripts/gen_tailscale_cert.py --check"]
  end

  subgraph storage["SQLite (WAL) · data/tasks.db"]
    t["tasks ⟲ parent_id<br/>external_id (v3)"]
    l["links"]
    c["comments<br/>external_id (v3)"]
    a["activity"]
    p["people"]
    i["issue_refs"]
    s["settings.schema_version"]
    fts["tasks_fts · comments_fts<br/>(FTS5, trigger-synced)"]
  end

  subgraph ops["Process / proof"]
    tray["app/tray · tray.bat --restart<br/>manager.py: cert --check → uvicorn --ssl-*"]
    gate["scripts/verify-before-ship.ps1"]
    seed["tests/fixtures/seed.py<br/>synthetic dataset"]
  end

