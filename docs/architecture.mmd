    enrich["enrich.py (#147)<br/>EnrichClient: the hub's chat endpoint, model NAMED<br/>prompt-only JSON (response_format is a 400 here)<br/>&lt;think&gt; + code fence stripped, allow-list read<br/>a date phrase must be VERBATIM in the transcript<br/>src/dates resolves it, never the model<br/>every failure ??? quick_add.parse + source:parser"]
    ai["ai/ (#95)<br/>client.py: Anthropic-shape local hub client<br/>one in-flight request · no retries · cached reachability<br/>triage.py: bounded context + whole-response validation<br/>stage only → individual accept/reject; accept actor=ai + Todo"]
    archive["archive_batch.py (#157)<br/>ArchiveBatchService: plan → decide → apply → rescan<br/>subprocess only, NO_WINDOW, bounded by timeout_seconds<br/>never imports the archiver; one child at a time (409)<br/>top candidate ≥ confidence_threshold, else needs_review<br/>date_prefix handed back unchanged · candidates kept verbatim<br/>revert · move (revert then apply) · accept<br/>failed rescan = done + error, never a clean run"]
    dates["dates.py<br/>parse_date · next_due · anchors (#112)"]
    qa["quick_add.py<br/>parse · resolve_parent · strip_lead_in"]
    schema["schema.py<br/>MIGRATIONS v1→v14 · migrate()"]
    db["db.py<br/>connect · init_db · get_db"]
    config["config.py<br/>config/config.json · auth {token, password_hash}<br/>save_auth() ← scripts/gen_token.py · set_password.py"]
    certs["certs.py<br/>webapp/certificates/{cert,key}.pem<br/>ensure_cert_fresh() → scripts/gen_tailscale_cert.py --check"]
  end

