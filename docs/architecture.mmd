  end

  subgraph webapp["FastAPI webapp · :8448 (HTTPS when webapp/certificates/ exists)<br/>app/webapp/server.py"]
    authmw["src/auth.py · AuthMiddleware<br/>loopback = owner · else bearer / cookie<br/>public: /static /healthz /api/version /login"]
    misc["routers/misc<br/>/ · /healthz · /api/version<br/>/opener/opener.{cmd,ps1} (public)"]
    authr["routers/auth<br/>/login · /api/login · /api/logout<br/>access_status() → /api/status"]
    tasksr["routers/tasks<br/>/api/tasks… · POST /api/tasks/bulk (#81)<br/>/api/activity · /api/parse (quick-add)"]
    peopler["routers/people<br/>/api/people…"]
    searchr["routers/search<br/>/api/search?q=&kinds= (federated)<br/>/api/search/status"]
    viewsr["routers/views<br/>/api/board · /api/today"]
    mirrorr["routers/mirror<br/>/api/status (+ folders · opener · placeholders)<br/>/api/mirror/export|import · GET/DELETE /api/mirror/events · /api/backup"]
    issuesr["routers/issues<br/>/api/issues/status · /api/issues/sync<br/>GET/POST /api/tasks/{id}/issue"]
    foldersr["routers/folders<br/>POST /api/resolve · /api/folders/search<br/>/api/folders/reindex"]
    errors["JSON error envelope<br/>{error:{code,message,detail?}}"]
    lifespan["lifespan → Mirror.start() · BackupScheduler.start()<br/>· IssueSyncService.start() · FolderIndexService.start()<br/>· build_federated() → app.state.search<br/>· repo.set_folder_resolver() · set_folder_web_resolver()"]
  end

  subgraph domain["Domain · src/"]
    repo["tasks_repo.py<br/>create/update/move/done · bulk_update (#81)<br/>comments · links · people<br/>issue_refs · search · activity<br/>board · today_view (buckets)<br/>write listeners (touched ids)"]
    mirror["mirror.py<br/>render/parse · export (debounced)<br/>import watcher (2 s) · conflict/rejected → mirror_events (#84)"]
    backup["backup.py<br/>run_backup (sqlite backup API)<br/>BackupScheduler daily 03:00 · keep 30"]
    issync["issue_sync.py<br/>sync_once: list → new coding tasks (inbox)<br/>title follows · closed → done · reopened → todo<br/>issue_from_task: task → new issue (route + CLI)<br/>IssueSyncService: 10 s after start, every sync_minutes"]
    issues["issues/<br/>base.py IssueProvider · IssueInfo<br/>github.py (gh search/view/create)<br/>fake.py (tests, e2e) · get_provider(config)"]
    placeholders["placeholders.py<br/>resolve(ref) · to_ref(path) · opener_url"]
    folderidx["folder_index.py<br/>FolderIndexService: roots · reindex (24 h) · search<br/>vendor/foldersearcher_core.py (verbatim)"]
    openerinfo["opener.py<br/>install.txt commands · opener.env template"]
    fedsearch["search/ (federated)<br/>federated.py: 4 groups · thread pool · 2 s each<br/>tasks_adapter (tasks_fts) · folders_adapter (index)<br/>emails_adapter (emails.db, mode=ro, bm25) · issues_adapter (refs + cache)"]
    dates["dates.py<br/>parse_date · advance"]
    qa["quick_add.py<br/>parse · resolve_parent"]
    schema["schema.py<br/>MIGRATIONS v1→v6 · migrate()"]
    db["db.py<br/>connect · init_db · get_db"]
    config["config.py<br/>config/config.json · auth {token, password_hash}<br/>save_auth() ← scripts/gen_token.py · set_password.py"]
    certs["certs.py<br/>webapp/certificates/{cert,key}.pem<br/>ensure_cert_fresh() → scripts/gen_tailscale_cert.py --check"]
  end

  subgraph storage["SQLite (WAL) · data/tasks.db"]
    t["tasks ⟲ parent_id<br/>external_id (v3)"]
    l["links"]
    c["comments<br/>external_id (v3)"]
    a["activity"]
    p["people"]
    i["issue_refs"]
    ms["mirror_state (v4)<br/>path · exported_at · mtime · hash"]
    me["mirror_events (v6)<br/>kind · field · file_value · kept_value<br/>deduped on (task_id, field, file_value)"]
    s["settings.schema_version"]
    fts["tasks_fts · comments_fts<br/>(FTS5, trigger-synced)"]
  end

  subgraph files["Synced folder · config.mirror"]
    mdfiles["mirror.dir/&lt;id&gt;-&lt;slug&gt;.md<br/>frontmatter · Description · Comments · Log"]
    bakfiles["backup_dir/tasks-YYYYMMDD.db"]
    roots["search.folder_roots<br/>({onedrive}/Documentos …)"]
    idxfile["data/folder_index.txt"]
  end

  subgraph external["Other repos' data (read-only)"]
    emaildb["email-archiver · emails.db<br/>emails · emails_fts (FTS5)<br/>config.search.email_db"]
  end

